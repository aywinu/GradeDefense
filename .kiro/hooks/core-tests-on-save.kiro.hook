{
  "enabled": true,
  "name": "Core Tests on Save",
  "description": "Run core unit tests when any file in src/core/ is edited",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/core/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npx vitest run src/core` and report any failing tests with the file and the reason. Do not change code unless asked."
  }
}